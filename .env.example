# ==========================================
# Automated Legal Document Analyzer Configuration (Example Template)
# Copy this file to .env and adjust values if needed.
# ==========================================

# LLM Provider: 'ollama' (default, free & local) or 'openai' (optional)
LLM_PROVIDER=ollama

# Ollama Local Configuration (No API Key Required)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Optional: OpenAI API Configuration (Only used if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
