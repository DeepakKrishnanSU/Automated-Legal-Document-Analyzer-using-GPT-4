# ==========================================
# Git Ignore Rules - Automated Legal Document Analyzer
# ==========================================

# Environment variables & secrets (keep .env.example tracked)
.env
.env.local
*.env
!.env.example

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Virtual Environments
venv/
.venv/
env/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# IDE & Editor Settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.gemini/

# Operating System Files
Thumbs.db
Desktop.ini
.DS_Store

# Temporary outputs & logs (keep structure tracked)
*.log
scratch/
